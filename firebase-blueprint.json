{
  "entities": {
    "GalleryConfig": {
      "title": "GalleryConfig",
      "description": "Main configuration document holding the construction services gallery structure and photo metadata.",
      "type": "object",
      "properties": {
        "servicesJson": {
          "type": "string",
          "description": "JSON serialized array of ServiceItem objects where base64 photo URLs are stored in gallery_photos collection."
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp in milliseconds when the gallery was last updated."
        },
        "updatedBy": {
          "type": "string",
          "description": "Identifier of the client/session that updated the gallery."
        }
      },
      "required": ["servicesJson", "updatedAt"]
    },
    "GalleryPhoto": {
      "title": "GalleryPhoto",
      "description": "Individual optimized real construction photo document stored separately to stay well within Firestore 1MB limit.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique photo slot ID."
        },
        "serviceId": {
          "type": "string",
          "description": "ID of the construction service category."
        },
        "dataUrl": {
          "type": "string",
          "description": "Optimized JPEG base64 Data URL (1200x900, quality 0.78)."
        },
        "subtitle": {
          "type": "string",
          "description": "Photo subtitle description."
        },
        "specNote": {
          "type": "string",
          "description": "Photo technical specification note."
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp in milliseconds when the photo was uploaded or updated."
        }
      },
      "required": ["id", "dataUrl", "updatedAt"]
    },
    "MemberProfile": {
      "title": "MemberProfile",
      "description": "Customer member profile tracking 1,000 KRW paid membership status and estimate ticket balance.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phone": { "type": "string" },
        "name": { "type": "string" },
        "tier": { "type": "string", "enum": ["regular", "paid_member"] },
        "ticketBalance": { "type": "number" },
        "totalTicketsPurchased": { "type": "number" },
        "totalSavedEstimates": { "type": "number" },
        "totalOrdersCount": { "type": "number" },
        "joinedAt": { "type": "number" },
        "lastLoginAt": { "type": "number" }
      },
      "required": ["id", "phone", "name", "tier", "ticketBalance"]
    },
    "EstimateTicket": {
      "title": "EstimateTicket",
      "description": "1,000 KRW single-use AI estimate ticket record.",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string" },
        "token": { "type": "string" },
        "userId": { "type": "string" },
        "userPhone": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "used", "refunded"] },
        "paymentMethod": { "type": "string" },
        "paymentOrderId": { "type": "string" },
        "createdAt": { "type": "number" },
        "usedAt": { "type": "number" }
      },
      "required": ["ticketId", "token", "userId", "userPhone", "amount", "status", "createdAt"]
    },
    "SupplyOrder": {
      "title": "SupplyOrder",
      "description": "Customer order for Jeongseok living care maintenance products.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "detailAddress": { "type": "string" },
        "finalAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["orderId", "userId", "userName", "userPhone", "deliveryAddress", "finalAmount", "status", "createdAt"]
    },
    "StoredEstimate": {
      "title": "StoredEstimate",
      "description": "User saved AI estimate result.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "category": { "type": "string" },
        "pyeong": { "type": "number" },
        "totalEstimateMin": { "type": "number" },
        "totalEstimateMax": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "category", "pyeong", "totalEstimateMin", "totalEstimateMax", "createdAt"]
    }
  },
  "firestore": {
    "/gallery_config/{configId}": {
      "schema": {
        "$ref": "#/entities/GalleryConfig"
      },
      "description": "Stores the global gallery configuration shared across all visitors in real time."
    },
    "/gallery_photos/{photoId}": {
      "schema": {
        "$ref": "#/entities/GalleryPhoto"
      },
      "description": "Stores individual base64 construction photos referenced by gallery_config/main."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/MemberProfile"
      },
      "description": "User profile with paid membership status and ticket balance."
    },
    "/tickets/{ticketId}": {
      "schema": {
        "$ref": "#/entities/EstimateTicket"
      },
      "description": "AI estimate ticket vouchers."
    },
    "/supply_orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/SupplyOrder"
      },
      "description": "Living care supplies orders."
    },
    "/user_estimates/{estimateId}": {
      "schema": {
        "$ref": "#/entities/StoredEstimate"
      },
      "description": "User saved estimate history."
    }
  }
}
